# ==============================================================================
# EthnizCouture Client Environment Configuration
# ==============================================================================

# API Base URL
# For local dev / tunneling: leave as "http://localhost:5000/api" or "/api" (auto-detected)
# For unified single-service production (Render/Railway/VPS): "/api"
# For decoupled production (Vercel client + Render server): "https://your-api-domain.com/api"
VITE_API_URL="/api"

# Stripe Publishable Key
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Razorpay Key ID
VITE_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"

# Google OAuth 2.0 Client ID (Web Client)
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Google Maps JavaScript API key (Optional for location picker)
# Required APIs: Maps JavaScript API, Places API, Geocoding API
# Restrict to HTTP referrers: https://yourdomain.com/*, http://localhost:5173/*
VITE_GOOGLE_MAPS_API_KEY=""
