# ==============================================================================
# EthnizCouture Production & Deployment Environment Configuration
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV="production"

# Database Connection
# For Local SQLite: "file:./dev.db"
# For Production PostgreSQL (Supabase, Neon, Render, Railway, AWS RDS):
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"

# Security (JWT secret must be >= 32 characters in production)
JWT_SECRET="generate_a_random_secure_32_character_string_here"
ADMIN_MASTER_KEY="EC-ROYAL-ATELIER-7K9F-2026-X8Q2"

# Domain & CORS
CLIENT_URL="https://ethnizcouture.com"
FRONTEND_URL="https://ethnizcouture.com"
CORS_ORIGINS="https://ethnizcouture.com,https://www.ethnizcouture.com"

# Email Notifications (Resend API)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Ethniz Couture <atelier@ethnizcouture.com>"

# Google OAuth 2.0 (Google Identity)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Razorpay Standard Checkout & UPI
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
UPI_MERCHANT_VPA="ethnizcouture@icici"
UPI_MERCHANT_NAME="Ethniz Couture"
