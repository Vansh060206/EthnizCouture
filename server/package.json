{
  "name": "ethnizcouture-server",
  "version": "1.0.0",
  "description": "Backend API for EthnizCouture Luxury Indian Ethnic-Wear",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "test:setup": "node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs src/scripts/setup_test_db.ts",
    "test:arch": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/architecture_and_scalability.test.ts",
    "test:security": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/jwt_config_and_auth_security.test.ts",
    "test:webhook": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/stripe_webhook_and_search.test.ts",
    "test:delivery": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/phase2d_delivery_location.test.ts",
    "test:modal": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/delayed_auth_modal.test.ts",
    "test:success-anim": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/order_success_animation.test.ts",
    "test:cod-pay": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/cod_online_payment_tracking.test.ts",
    "test:account": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/mobile_account_hub.test.ts",
    "test:upi-qr": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/dynamic_upi_qr_payment.test.ts",
    "test:razorpay": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/razorpay_standard_checkout.test.ts",
    "test:fulfilment": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/admin_order_fulfilment.test.ts",
    "test:google-auth": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/google_auth_and_welcome_email.test.ts",
    "test:order-email": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/order_confirmation_notification.test.ts",
    "test:inquiries": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/admin_contact_inquiries.test.ts",
    "test:billing-gst": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/checkout_billing_and_gstin.test.ts",
    "test": "npm run test:setup && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/architecture_and_scalability.test.ts && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/jwt_config_and_auth_security.test.ts && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/stripe_webhook_and_search.test.ts && node --env-file=.env.test ./node_modules/tsx/dist/cli.mjs --test test/phase2d_delivery_location.test.ts",
    "prisma:staging:push": "node --env-file=.env.staging ./node_modules/prisma/build/index.js db push --schema=prisma/schema.postgresql.prisma --skip-generate",
    "prisma:pg:generate": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "staging:migrate": "node --env-file=.env.staging ./node_modules/tsx/dist/cli.mjs src/scripts/migrate_postgres_staging.ts",
    "staging:test": "node --env-file=.env.staging ./node_modules/tsx/dist/cli.mjs --test test/postgres_staging_validation.test.ts",
    "staging:verify": "node --env-file=.env.staging ./node_modules/tsx/dist/cli.mjs src/scripts/independent_supabase_verify.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "slugify": "^1.6.6",
    "stripe": "^17.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
